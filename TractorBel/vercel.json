{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    { "source": "/(.*).js", "headers": [{"key":"Access-Control-Allow-Origin","value":"*"},{"key":"Cache-Control","value":"public,max-age=0,must-revalidate"},{"key":"X-Content-Type-Options","value":"nosniff"}] },
    { "source": "/(.*).css", "headers": [{"key":"Access-Control-Allow-Origin","value":"*"},{"key":"Cache-Control","value":"public,max-age=0,must-revalidate"},{"key":"X-Content-Type-Options","value":"nosniff"}] },
    { "source": "/assets/(.*)", "headers": [{"key":"Access-Control-Allow-Origin","value":"*"},{"key":"Cache-Control","value":"public,max-age=31536000,immutable"}] }
  ]
}